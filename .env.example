# ============================================================
# PhishGuard AI - Environment Configuration Example
# ============================================================
# Copy this file to .env for local development.
# NEVER commit real secrets to Git.
#
# Docker:
#   Use .env.docker with Docker service hostnames.
# ============================================================


# ------------------------------------------------------------
# Threat Intelligence
# ------------------------------------------------------------

# VirusTotal API key
VT_API_KEY=your_virustotal_api_key_here


# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------

# Local development
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/phishguard


# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------

# Local development
REDIS_URL=redis://localhost:6379/0

# Redis cache lifetime in seconds
REDIS_CACHE_TTL=900


# ------------------------------------------------------------
# Async Processing
# ------------------------------------------------------------

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2


# ------------------------------------------------------------
# Authentication
# ------------------------------------------------------------

# Generate a strong random value for production.
# Example:
# python -c "import secrets; print(secrets.token_urlsafe(64))"

JWT_SECRET_KEY=your_long_random_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60


# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

LOG_LEVEL=INFO

# Optional: number of application workers
# WORKERS=4

ALLOWED_ORIGINS=http://localhost:5173
APP_ENV=development