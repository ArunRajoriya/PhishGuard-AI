# =========================================================
# PhishGuard AI - .gitignore
# =========================================================

# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# -------------------------
# Virtual environments
# -------------------------
venv/
ENV/
env/
.venv/

# -------------------------
# Environment / secrets
# -------------------------
.env
.env.local
.env.*.local
.env.*

# Keep the example environment file
!.env.example

# -------------------------
# Build / packaging
# -------------------------
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
wheels/
*.egg-info/
.installed.cfg
*.egg

# -------------------------
# Frontend
# -------------------------
frontend/node_modules/
frontend/dist/
frontend/.vite/

# -------------------------
# Database
# -------------------------
*.db
*.sqlite
*.sqlite3
database/*.db

# -------------------------
# IDE / Editor
# -------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# -------------------------
# Logs
# -------------------------
*.log
logs/

# -------------------------
# ML datasets / temporary data
# -------------------------
data/raw/
data/processed/

# Generated datasets
*.csv

# -------------------------
# ML model artifacts
# -------------------------
# Models are large binary artifacts.
# Do NOT commit them directly to GitHub.
model/*.pkl
model/*.joblib
model/*.onnx

# -------------------------
# ML generated reports / metrics
# -------------------------
# Keep JSON metrics/schema files tracked.
# Ignore only temporary/generated report formats.
model/*.html

# -------------------------
# Python testing
# -------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# -------------------------
# Jupyter
# -------------------------
.ipynb_checkpoints/

# -------------------------
# Docker
# -------------------------
.dockerignore

# -------------------------
# OS
# -------------------------
Thumbs.db
.DS_Store

# -------------------------
# Vercel
# -------------------------
.vercel/